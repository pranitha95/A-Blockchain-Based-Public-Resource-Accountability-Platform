# ---------------------------------------------------------------------------
# Proof of Impact — environment template
# Copy to `.env` and adjust. Never commit a populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL — any standard PostgreSQL 16+ instance works.
# `npm run dev:db` starts an embedded PostgreSQL 17 development server on port 55432.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/proof_of_impact

# Session cookies. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
RATE_LIMIT_ENABLED=true

# Local file storage. Keep outside any executable web root.
FILE_STORAGE_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760

# Demonstration data. SEED_DEMO_PASSWORD is required to seed demo accounts and
# is rejected when NODE_ENV=production. Demo data is explicitly labelled in the UI.
DEMO_MODE=true
SEED_DEMO=true
SEED_DEMO_PASSWORD=change-this-development-password

# ---------------------------------------------------------------------------
# Blockchain — Ethereum Sepolia by default.
# Leave CONTRACT_ADDRESS empty until you have deployed the contract.
# Never place a private key or paid RPC credential in this file.
# ---------------------------------------------------------------------------
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
EXPLORER_BASE_URL=https://sepolia.etherscan.io
ANCHOR_CONFIRMATIONS=2
RECONCILE_INTERVAL_MS=60000

# Serve the built frontend from the API in single-server deployments.
SERVE_WEB=false
